      "id": "87ce66fd",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### Printing an empty line\n",
        "\n",
        "Calling `print()` without an argument produces an empty line:"
      ],
      "id": "5abef6b3"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "print(\"First line\")\n",
        "print()\n",
        "print(\"Third line\")"
