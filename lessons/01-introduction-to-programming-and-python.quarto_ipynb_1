      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "By default, Python separates the values with spaces.\n",
        "\n",
        "Text, numbers, and expressions can also be combined:"
      ],
      "id": "75df7685"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "print(\"5 * 6 is\", 5 * 6)"
